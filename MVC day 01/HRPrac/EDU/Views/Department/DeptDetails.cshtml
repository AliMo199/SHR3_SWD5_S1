@model DepartmentDetailsViewModel
@{
	ViewData["Title"] = "Department Details";
}
<h2>Department: @Model.DepartmentName</h2>

@if (Model.Employees.Any())
{
    <table class="table table-bordered table-hover">
        <tr>
            <th >Employees</th>
            <th>Actions</th>
        </tr>
        @foreach (var employee in Model.Employees)
        {
            <tr>
                <td>@employee.Name</td>
                <td><a asp-action="EmpDetails" asp-controller="Employee" asp-route-id="@employee.EmployeeId">Details</a></td>
            </tr>
        }
    </table>
    <a href="javascript:history.go(-1)" class="btn btn-warning">Back to list</a>
}
else
{
    <p>No employees in this department.</p>
    <a href="javascript:history.go(-1)" class="btn btn-warning">Back to list</a>
}