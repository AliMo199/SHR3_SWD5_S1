@using WebApp.ViewModels
@model StudentDetailsViewModel
@{
	ViewData["Title"] = "Edit Student";
	SelectList Deptlist = new SelectList(Model.departments, "Id", "Name");
}
<form asp-controller="Student" asp-action="Edit" method="post">
	<input type="hidden" asp-for="Id" />
	<div class="form-group mb-3">
		<label>Name</label>
		<input asp-for="Name" class="form-control" />
		<span asp-validation-for="Name" class="text-danger"></span>
	</div>
	<div class="form-group mb-3">
		<label>Age</label>
		<input asp-for="Age" class="form-control" />
		<span asp-validation-for="Age" class="text-danger"></span>
	</div>
	<div>
		<label>Department</label>
		<select asp-for="DepartmentId" class="form-control" asp-items="Deptlist">
			<option value="0" disabled>Select your option</option>
		</select>
	</div>
	<div class="mt-2">
		<button type="submit" class="btn btn-primary">Save</button>
		<a asp-controller="Student" asp-action="ShowAll" class="btn btn-secondary">Cancel</a>
	</div>
	</form>