@model List<Department>

@{
    ViewData["Title"] = "All Departments";
	Layout = "_TemplateLayout";
}

<h2 class="text-light">Departments</h2>

<a asp-controller="Department" asp-action="Add" class="btn btn-success mb-3">Add New Department</a>

<table class="table table-hover table-bordered">
    <thead>
        <tr class="text-light">
            <th>ID</th>
            <th>Name</th>
            <th>Manager</th>
            <th>Students Count</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var dept in Model)
        {
            <tr class="text-light">
                <td>@dept.Id</td>
                <td>@dept.Name</td>
                <td>@dept.MgrName</td>
                <td>@dept.Students?.Count</td>
                <td>
                    <a asp-controller="Department" asp-action="ShowDetailsById" asp-route-id="@dept.Id" class="btn btn-info btn-sm">Details</a>


                </td>
            </tr>
        }
    </tbody>
</table>