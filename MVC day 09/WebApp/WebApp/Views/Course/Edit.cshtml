@model Course
@{
	ViewData["Title"] = "Add Course";
	ViewBag.Departments = new SelectList(ViewBag.Departments, "Id", "Name");
}
<h2 class="text-dark">Edit Course</h2>
<form asp-controller="Course" asp-action="Edit" method="post">

	<div class="form-group mb-3">
		<label asp-for="Name" class="form-label text-dark"></label>
		<input asp-for="Name" class="form-control" />
		<span asp-validation-for="Name" class="text-danger"></span>
	</div>
	<div class="form-group mb-3">
		<label asp-for="Degree" class="form-label text-dark"></label>
		<input asp-for="Degree" class="form-control" />
		<span asp-validation-for="Degree" class="text-danger"></span>
	</div>
	<div class="form-group mb-3">
		<label asp-for="MinDegree" class="form-label text-dark"></label>
		<input asp-for="MinDegree" class="form-control" />
		<span asp-validation-for="MinDegree" class="text-danger"></span>
	</div>
	<div class="form-group mb-3">
		<label asp-for="DepartmentId" class="form-label text-dark"></label>
		<select asp-for="DepartmentId" class="form-control" asp-items="ViewBag.Departments">
			<option value="0" disabled selected>Select your option</option>
		</select>
		<span asp-validation-for="DepartmentId" class="text-danger"></span>
	</div>
	<button type="submit" class="btn btn-primary">Edit</button>
	<a asp-controller="Course" asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>