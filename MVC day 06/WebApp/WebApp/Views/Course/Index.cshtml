@model List<Course>
@{
	ViewData["Title"] = "All Courses";
}
<h2 class="text-dark">Courses</h2>
<a asp-controller="Course" asp-action="Add" class="btn btn-success mb-3">Add New Course</a>
<table class="table table-hover table-bordered">
	<thead>
		<tr class="text-light">
			<th>ID</th>
			<th>Name</th>
			<th>Degree</th>
			<th>MinDegree</th>
			<th>Actions</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var course in Model)
		{
			<tr class="text-light">
				<td>@course.Id</td>
				<td>@course.Name</td>
				<td>@course.Degree</td>
				<td>@course.MinDegree</td>
				<td>
					<a asp-controller="Course" asp-action="Details" asp-route-id="@course.Id" class="btn btn-info btn-sm">Details</a>
					<a asp-controller="Course" asp-action="Edit" asp-route-id="@course.Id" class="btn btn-primary btn-sm">Edit</a>
					<a asp-controller="Course" asp-action="Delete" asp-route-id="@course.Id" class="btn btn-danger btn-sm">Delete</a>
				</td>
			</tr>
		}
