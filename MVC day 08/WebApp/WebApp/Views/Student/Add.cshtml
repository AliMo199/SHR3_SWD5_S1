@using WebApp.ViewModels
@model StudentDetailsViewModel

@{
    ViewData["Title"] = "Add Student";
    SelectList Deptlist = new SelectList(Model.departments, "Id", "Name");
}

<h2>Add Student</h2>

<form asp-controller="Student" asp-action="Add" method="post">
    <div class="form-group mb-3">
        <label>Name</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label>Age</label>
        <input asp-for="Age" class="form-control" />
        <span asp-validation-for="Age" class="text-danger"></span>
    </div>
    <div>
		<label>Department</label>
        <select asp-for="DepartmentId" class="form-control" asp-items="Deptlist">
            <option value="0" disabled selected>Select your option</option>
        </select>
    </div>
    <div class="mt-2">
        <button type="submit" class="btn btn-primary">Add</button>
        <a asp-controller="Student" asp-action="ShowAll" class="btn btn-secondary">Cancel</a>
    </div>
    
</form>