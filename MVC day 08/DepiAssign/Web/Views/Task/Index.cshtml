@model List<TaskItem>
@{
	ViewData["Title"] = "Task List";
}
<h1>Tasks List</h1>
<a asp-action="Create" class="btn btn-success mb-3">Create New Task</a>
<table class="table">
	<thead>
		<tr>
			<th>Id</th>
			<th>Title</th>
			<th>Due Date</th>
			<th>Is Completed</th>
			<th>Actions</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var task in Model)
		{
			<tr>
				<td>@task.id</td>
				<td>@task.Title</td>
				@if(task.DueDate != null)
				{
					<td>@task.DueDate?.ToString("g")</td>
				}
				else
				{
					<td>N/A</td>
				}
				<td>@(task.IsCompleted ? "Yes" : "No")</td>
				<td>
					<a asp-action="Details" asp-route-id="@task.id" class="btn btn-info">Details</a>
					<a asp-action="Edit" asp-route-id="@task.id" class="btn btn-primary">Edit</a>
					<a asp-action="Delete" asp-route-id="@task.id" class="btn btn-danger">Delete</a>
				</td>
			</tr>
		}
	</tbody>
